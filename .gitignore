# Dependencies (installed by composer on the server: umask 027 && composer install)
/vendor/
composer.phar

# Generated by the build (composer build); never committed
/public/legal/index.html
/public/legal/assets/
/public/legal/data/
/app/data/form-data.json
/app/data/assets-*.json
/app/storage/fonts/
/.phpunit.cache/
.phpunit.result.cache

# Secrets: real config lives in /etc/vea-intake/app.env, never in the repo
*.env
.env
.env.*

# Logs, temp files, local scratch
*.log
*.tmp
*.swp
*~
/scratch/

# Editor / OS / remote-dev
.vscode/
.vscode-server/
.idea/
.DS_Store
Thumbs.db

# Claude Code local settings
.claude/settings.local.json

# Temporary trees of bin/fix-vendor-perms.php (only left behind if it crashed)
/.vendor-*/

# Playwright e2e (tests/e2e): dependencies and run output
/tests/e2e/node_modules/
/tests/e2e/.node_modules-*/
/tests/e2e/test-results/
/tests/e2e/playwright-report/
